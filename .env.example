# Supabase Postgres connection string (Shared transaction-mode pooler, IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"

# Primary OpenRouter API key
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional additional OpenRouter keys. When the primary key reaches its 50/day
# free-model cap, chat requests automatically rotate to these keys, then to the
# keyless Pollinations tier if every key is exhausted.
# Comma (or whitespace) separated. OPENROUTER_API_KEYS is accepted as an alias.
OPENROUTER_FALLBACK_KEYS="sk-or-v1-...,sk-or-v1-..."
